{
  "name": "violet-ui",
  "version": "0.1.0",
  "description": "Vue 3 component library for SaaS dashboards: forms, overlays, navigation, data table, theming.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoncoJS/Violet-Library.git",
    "directory": "packages/violet-ui"
  },
  "keywords": [
    "vue",
    "vue3",
    "components",
    "ui",
    "design-system",
    "data-table"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./resolver": {
      "types": "./dist/resolver.d.ts",
      "import": "./dist/resolver.js"
    },
    "./style.css": "./dist/style.css",
    "./volar": {
      "types": "./volar.d.ts"
    },
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "volar.d.ts"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist coverage"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
